  "protocol": {
    "item": "CT C-spine Protocol",
    "protocol_type": "ed_protocol",
    "source_text": "\u0001\u0002\n\u0003\u0004\u0005\u0006\u0007\u0004\b\u0004\t\n\u0003\u0004\u000b\f\r\u000e\u000f\u0004\u0010\u0007\u0011\u0012\u0010\u0013\u0007\u0011\u000e\u000f\u0004\u0014\u0007\u0015\u0011\f\u000f\f\u0006\u0012\r\u000e\u000f\u0004\u0016\u0007\u0017\u0012\r\u0012\u0018\u0004\f\u0011\u0004\u0010\u000e\u0011\u000e\u0007\u0019\u0018\u0013\u0007\u0019\u0012\u000e\u0019\n\u001a\u001b\u001c\n\u0003\u0004\u001d\u000e\u0014\u0006\u0007\u0011\f\u0015\u0019\u0004\u001e\u0007\r\u0013\u000e\u0014\u0012\u0019\u001e\u0004\f\u0017\u0004\u0012\u0014\u001f\u0015\u0011 \n!\u0004\"\u0007\u0016\u0007\u0019\u0018\u0011\u0012\u000e\u0014\u0004\f\u0011\u0004\r \r\u000f\u0012\u0019\u0018\u0004\u0019\u0018\u0011\u0015\r#\u0004$ \u0004%\u0007\u0013\u0012\r\u000f\u0007\n!\u0004\u0002\r\r\u0015\u0010\u000e\u0014\u0018\u0004\u0007\u001f\u0007\r\u0018\u0007\u0016\u0004\u0017\u0011\f\u001e\u0004%\u0007\u0013\u0012\r\u000f\u0007\n!\u0004\u000b\u000e\u000f\u000f\u0004\u0017\u0011\f\u001e\u0004\u0013\u0007\u0012\u0006\u0013\u0018\u0004&\u0004'\u001e\u0004\f\u0011\u0004\n\u0004\u0019\u0018\u000e\u0012\u0011\u0019\n!\u0004\u0005(\u0012\u000e\u000f\u0004\u000f\f\u000e\u0016\u0004\u0018\f\u0004\u0013\u0007\u000e\u0016\u0004\u0007)\u0006)\u0004\u0016\u0012%\u0012\u0014\u0006\n!\u0004*\u0012\u0006\u0013\u0003\u0019\u0010\u0007\u0007\u0016\u0004\u001e\f\u0018\f\u0011\u0004%\u0007\u0013\u0012\r\u000f\u0007\u0004\r\f\u000f\u000f\u0012\u0019\u0012\f\u0014\n!\u0004+\f\u000f\u000f\u0003\f%\u0007\u0011\u0004\u001e\f\u0018\f\u0011\u0004%\u0007\u0013\u0012\r\u000f\u0007\u0004\u000e\r\r\u0012\u0016\u0007\u0014\u0018\n\u001a\u001b\u001c\n\u0001\u0002\n\u0001\u0002\u0003\u0004\u0005\u0006\u0003\u0007\b\u0004\u0001\u0006\t\u0004\n')\u0004\u000e\u000f\u0007\u0011\u0018\u0004\u000e\u0014\u0016\u0004\f\u0011\u0012\u0007\u0014\u0018\u000e\u0018\u0007\u0016,\n-)\u0004\u0014\f\u0018\u0004\u0012\u0014\u0018\f(\u0012\r\u000e\u0018\u0007\u0016\u0004$ \u0004\u0016\u0011\u0015\u0006\u0019\u0004\u000e\u0014\u0016.\f\u0011\u0004\u000e\u000f\r\f\u0013\f\u000f\u0004,\n\u0001\u0002\n/)\u0004\u0014\f\u0018\u0004\u0016\u0012\u0019\u0018\u0011\u000e\r\u0018\u0007\u0016\u0004$ \u0004\f\u0018\u0013\u0007\u0011\u0004\u001c01\u00010\u000b02\u0005\u00013\u0004\u0012\u0014\u001f\u0015\u0011\u0012\u0007\u0019,\n\u001a\u001b\u001c\n\u0003\u00040\u0014%\f\u000f%\u0007\u0016\u0004\u0012\u0014\u0004\u0019\u0012\u001e\u0010\u000f\u0007\u0004\u0011\u0007\u000e\u0011\u0003\u0007\u0014\u0016\u0004\u001e\f\u0018\f\u0011\u0004%\u0007\u0013\u0012\r\u000f\u0007\u0004\r\f\u000f\u000f\u0012\u0019\u0012\f\u0014\n\u0003\u00040\u0019\u0004\r\f\u001e\u0017\f\u0011\u0018\u000e$\u000f\u0007\u0004\u0012\u0014\u0004\u0019\u0012\u0018\u0018\u0012\u0014\u0006\u0004\u0010\f\u0019\u0012\u0018\u0012\f\u0014\u0004\u0012\u0014\u0004\u001b\u001e\u0007\u0011\u0006\u0007\u0014\r \u0004\u001d\u0007\u0010\u000e\u0011\u0018\u001e\u0007\u0014\u0018\n\u0003\u0004*\u000e\u0019\u0004$\u0007\u0007\u0014\u0004\u000e\u001e$\u0015\u000f\u000e\u0018\f\u0011 \u0004\u000e\u0018\u0004\u000e\u0014 \u0004\u0018\u0012\u001e\u0007\u0004\u0019\u0012\u0014\r\u0007\u0004\u0019\u0012\u0014\r\u0007\u0004\u0012\u0014\u001f\u0015\u0011 \n\u0001\u0002\n\u0003\u0004\"\u0011\u0007\u0019\u0007\u0014\u0018\u0007\u0016\u00044\u0012\u0018\u0013\u0004\u0016\u0007\u000f\u000e \u0007\u0016\u0004\f\u0014\u0019\u0007\u0018\u0004\f\u0017\u0004\u0014\u0007\r#\u0004\u0010\u000e\u0012\u0014\n\b\t\u000b\n\u0003\u0004\u0005\"\n\u0003\u00045\u000e\u0018\u0007\u0011\u000e\u000f\u000467\u0004\u001c4\u0012\u001e\u001e\u0007\u00118\u0019\u0004%\u0012\u000749\n\u0001\u0002\n\u001a\u001b\u001c\n\u0003\u0004\u0002\u0010\u0007\u0014\u0004\u001e\f\u0015\u0018\u0013\n')\u00043\u0007\r\u0013\u0014\u0012\r\u000e\u000f\u000f \u0004\u0012\u0014\u000e\u0016\u0007:\u0015\u000e\u0018\u0007,\n-)\u0004\u001c\u0015\u0019\u0010\u0012\r\u0012\f\u0015\u0019,\n/)\u0004\u0002\u0011\u0004\u0016\u0007\u0017\u0012\u0014\u0012\u0018\u0007\u000f \u0004\u000e$\u0014\f\u0011\u001e\u000e\u000f,\n\u001a\u001b\u001c\n\u0001\u0002\n\u001a\u001b\u001c\n\b\f\u0002\u0006\t\r\u0006\u0003\u000e\u000f\u0003\u0010\u0001\u000b\u0011\u0001\t\u0006\u0003\t\u0006\r\u0012\u0003\u0004\u0006\t\u000b\u0006\u0013\t\u0006\u0002\u0002\n\u0007\u0006\u0013\u000f\u000e\u0013\u0010\u0003\u0014\u0015\u0016\u0001\u0006\u0017\u0003\r\u0015\u0002\u0007\u0001\t\u0006\u0003\u0018\u0015\u0013\b\u0019\u0002\n\b\u0013\u0006\u0003\u0004\u0005\u0006\u0003\u0014\u0015\u0016\u0001\u0006\u0017\u0003\r\u0015\u0002\u0007\u0001\t\u0006\u0003\u0018\u0015\u0013\b\u0019\u0002\n\u0007\u0006\u0013\u000f\u000e\u0013\u0010\u0003\r\u0004\u0003\r\u0015\u0002\u0007\u0001\t\u0006\n\r\b\t\u0003\u0004\u0005\u0006\u0003\u0007\b\u0004\u0001\u0006\t\u0004\u0003\b\r\u0004\u0001\u0016\u0006\u0011\u0019\u0003\u001a\u001b\u001c\u0003\u0007\b\u0001\t\u000f\u0013\u0006\u0006\u0003\u0013\u000e\u0004\b\u0004\u0006\u0003\t\u0006\r\u0012\u0003\u0004\u000e\n\u001d\u001e\u001f\u0003\u0011\u0006\u000f\u0004 \u0003\u0013\u0001!\u0005\u0004\u0003\b\t\u000b\u0003\u000f\u0011\u0006\u0018\u0003\r\u0005\u0001\t\u0003\u0004\u000e\u0003\r\u0005\u0006\u0002\u0004\"\n\t\u000e\u0003\u000f#\u0013\u0004\u0005\u0006\u0013\u0003\u0001\u0010\b!\u0001\t!\u0003\u0013\u0006$#\u0001\u0013\u0006\u000b\u0003\u0015\u0003\r\u0015\u0002\u0007\u0001\t\u0006\u0003\r\u0011\u0006\b\u0013\n\u0005\u0001!\u0005\u0003\u0013\u0001\u0002\u0012\u0003\u000f\b\r\u0004\u000e\u0013\u0002\u0003\u0017\u0005\u0001\r\u0005\u0003\u0010\b\t\u000b\b\u0004\u0006\u0003\u0013\b\u000b\u0001\u000e!\u0013\b\u0007\u0005\u0019\"\n\u0007\u000e\u0002\u0002\u0001\f\u0011\u0006\u0003\r\u0015\u0002\u0007\u0001\t\u0006\u0003\u0001\t%#\u0013\u0019\u0003\b\t\u000b\u0003\b\t\u0019\u0003\u000e\t\u0006\u0003\u000e\u000f\u0003\u0004\u0005\u0006\u0003\u000f\u000e\u0011\u0011\u000e\u0017\u0001\t!\u0003\u0007\u0013\u0006\u0002\u0006\t\u0004\"\n\u0001\u0002\u0003\u0004\u0005\u0006\u0013\u0006\u0003\b\t\u0019\u0003\u0001\t\u000b\u0001\r\b\u0004\u0001\u000e\t\u0003\u0004\u000e\u0003\u000b\u000e\u0003\b\u0003\n\r\u0004\u0003\f\u0013\b\u0001\t\u0003\u0002\r\b\t\u0003\b\u0002\u0003\u0007\u0006\u0013\u0003\u0005\u0006\b\u000b\u0003\u0001\t%#\u0013\u0019\u0003\n\u0007\u0013\u000e\u0004\u000e\r\u000e\u0011\"\u0003\n\u0007\u0006\u0013\u000f\u000e\u0013\u0010\u0003\t\u000e\t\u0015\n\r\u000e\t\u0004\u0013\b\u0002\u0004\u0003\r\u0004\u0003\f\u0013\b\u0001\t\u0003\n\b\t\u000b\u0003\r\u0015\u0002\u0007\u0001\t\u0006\nCT C-spine Protocol\nCANADIAN CT C-sine RULE \n"
  }
