  "record": {
    "name": "MELD Score",
    "category": "hepatology",
    "calculator_type": "formula",
    "formula_id": "meld",
    "formula": "3.78*ln(bilirubin) + 11.2*ln(INR) + 9.57*ln(creatinine) + 6.43",
    "review_note": "Estimates 3-month mortality in chronic liver disease. Lab values below 1.0 are floored to 1.0; creatinine is capped at 4.0 (forced to 4.0 if the patient has had dialysis twice in the past week); the final score is rounded and clamped to the standard 6-40 reporting range.",
    "inputs": [
      {
        "name": "Bilirubin",
        "key": "bilirubin",
        "unit": "mg/dL"
      },
      {
        "name": "INR",
        "key": "inr",
        "unit": "ratio"
      },
      {
        "name": "Creatinine",
        "key": "creatinine",
        "unit": "mg/dL"
      },
      {
        "name": "Dialysis twice in past week",
        "key": "on_dialysis",
        "unit": "1 = yes, 0 = no"
      }
    ]
  }
