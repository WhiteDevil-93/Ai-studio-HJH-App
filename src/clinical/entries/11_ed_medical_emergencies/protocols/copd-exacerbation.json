  "record": {
    "item": "COPD Exacerbation",
    "protocol_type": "ed_protocol",
    "management_steps": [
      {
        "step_number": "1",
        "action": "Oxygen Therapy & Nebulisation",
        "details": "Titrate oxygen carefully to target Sats 88-92% (prevent hypercapnic respiratory drive failure). Deliver Salbutamol + Ipratropium Bromide nebs."
      },
      {
        "step_number": "2",
        "action": "Steroids & Antibiotics",
        "details": "Give Hydrocortisone 200mg IV stat (or Prednisone 0.5mg/kg PO). If infection is suspected (increased sputum volume/purulence/fever): Augmentin 1g BD PO (or 1.2g IV) + Azithromycin 500mg PO daily."
      },
      {
        "step_number": "3",
        "action": "Non-Invasive Ventilation (NIV)",
        "details": "NIV (BiPAP) is highly effective for COPD respiratory acidosis (pH < 7.35, PaCO2 > 45mmHg). Reduces intubation rates dramatically."
      }
    ],
    "embedded_drugs": [
      {
        "item": "Salbutamol",
        "adult_dose": "2.5-5mg nebulised (Nebulise with O2); 0.25-0.5mg IV",
        "paediatric_dose": "2.5-5mg nebulised; 5-10ug/kg/min IV"
      },
      {
        "item": "Berotec/Atrovent",
        "adult_dose": "0.5mg/2.5mg nebulised (repeat 20min x 3)",
        "paediatric_dose": "0.25-0.5mg/1.25-2.5mg nebulised"
      },
      {
        "drug": "Hydrocortisone",
        "adult_dose": "Stress: 50-100mg IV 6-8hrly; Physiological: 20mg AM + 10mg PM",
        "paediatric_dose": "Stress: 1-2mg/kg IV 6hrly",
        "notes_updates": "Stress dose for adrenal insufficiency, septic shock"
      }
    ]
  }
