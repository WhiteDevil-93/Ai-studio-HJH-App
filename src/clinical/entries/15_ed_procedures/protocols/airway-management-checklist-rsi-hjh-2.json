    "management_steps": [
      {
        "step_number": "1",
        "action": "Check Equipment & Predict Difficult Airway",
        "details": "Use LEMON criteria. Verify suction and alternative airways."
      },
      {
        "step_number": "2",
        "action": "Positioning & Pre-oxygenation",
        "details": "Align ear to sternal notch (sniffing position). Pre-oxygenate 100% for 3 min."
      },
      {
        "step_number": "3",
        "action": "Pre-load Fluids",
        "details": "10-20ml/kg Ringer's Lactate/Balsol to offset induction-induced hypotension."
      },
      {
        "step_number": "4",
        "action": "Induction & Paralysis",
        "details": "Induction (Ketamine 1-2mg/kg IV or Etomidate 0.3mg/kg IV) followed by paralytic (Suxamethonium 1.5mg/kg IV or Rocuronium 1mg/kg IV)."
      }
    ]
  }
